--- !u!114 &7218974630687444557
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 103786380192774648}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 571f0a4bda1c49e68472f230a1f396ae, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LobbyAdmin
  interactableLayer:
    serializedVersion: 2
    m_Bits: 4294967295
  _trigger: {fileID: 6258564572197856072}
  _tutor: {fileID: 1342515522583372275}
  _dialogs:
  - "\u0417\u0434\u0440\u0430\u0441\u044C\u0442\u0435, \u044F \u0442\u0443\u0442
    \u044D\u0442\u043E... \u043D\u0430 \u0439\u043E\u0433\u0443"
  - "\u0414\u043E\u0431\u0440\u044B\u0439 \u043F\u0440\u043E\u0441\u0432\u0435\u0442\u043B\u0435\u043D\u043D\u044B\u0439
    \u0432\u0435\u0447\u0435\u0440, \u0432\u044B \u043F\u0435\u0440\u0432\u044B\u0435?"
  - "\u041D\u0443 \u0434\u0430, \u0443 \u0432\u0430\u0441 \u0436\u0435 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E\u0435
    \u0437\u0430\u043D\u044F\u0442\u0438\u0435 \u0441 \u043F\u0438\u0432\u043E\u043C"
  - "\u041A\u0430\u043A\u0438\u043C \u043F\u0438\u0432\u043E\u043C?"
  - "\u041D\u0443 \u043F\u0438\u0432\u043E\u043C, \u043F\u0438\u0432\u043D\u0430\u044F
    \u0439\u043E\u0433\u0430, \u043C\u043D\u0435 \u043A\u0430\u043A \u0440\u0430\u0437
    \u043E\u043F\u043E\u0445\u043C\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u043D\u0443\u0436\u043D\u043E"
  - "\u0422\u0430\u043A, \u0438\u0434\u0438\u0442\u0435 \u043A \u0442\u0440\u0435\u043D\u0435\u0440\u0443,
    \u043E\u043D \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u0442\u0441\u044F. \u0421\u043A\u0430\u0436\u0438\u0442\u0435,
    \u0447\u0442\u043E \u043D\u0430 \u043F\u0440\u043E\u0431\u043D\u043E\u0435 \u0437\u0430\u043D\u044F\u0442\u0438\u0435.
    \u041D\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0434\u0435\u043D\u044C\u0442\u0435
    \u0444\u043E\u0440\u043C\u0443"
