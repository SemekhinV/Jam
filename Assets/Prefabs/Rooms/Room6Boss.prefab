--- !u!114 &8823205913617593757
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1988651233477343797}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 34013b0b6a97419abbabdf7fa6eb5a91, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BossRoom
  _enterRoomDialogs:
  - "\u0422\u0430\u043A, \u0430 \u0442\u044B \u0442\u0443\u0442 \u043A\u0442\u043E,
    \u0442\u0440\u0435\u043D\u0435\u0440?"
  - "\u0417\u0440\u0430\u0441\u0442\u0432\u0443\u0439 \u0441\u044B\u043D \u043C\u043E\u0439.
    \u0427\u0442\u043E \u043F\u0440\u0438\u0432\u0435\u043B\u043E \u0442\u0435\u0431\u044F
    \u043A\u043E \u043C\u043D\u0435?"
  - "\u041F\u0438\u0432\u043E"
  - "\u0422\u0438\u0445\u043E... \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0443\u0437\u0440\u0438
    \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u044C
    \u0444\u0440\u0430\u043A\u0442\u0430\u043B\u043E\u0432 \u0438 \u043F\u043E\u0441\u0442\u0438\u0433\u043D\u0438
    \u0441\u0443\u0442\u044C \u043C\u0438\u0440\u043E\u0437\u0434\u0430\u043D\u0438\u044F..."
  - "\u0422\u0430\u043A \u044D\u0442\u043E, \u0430 \u043F\u0438\u0432\u043E \u0433\u0434\u0435?"
  - "\u041A\u0430\u043A\u043E\u0435 \u043F\u0438\u0432\u043E?"
  - "\u0423 \u0432\u0430\u0441 \u043D\u0430 \u0431\u0443\u043A\u043B\u0435\u0442\u0435
    \u0431\u044B\u043B\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E \"\u0439\u043E\u0433\u0430
    \u0441 \u043F\u0438\u0432\u043E\u043C\""
  - "\u0422\u0430\u043C \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E \"\u043F\u0440\u0430\u043D\u0430\",
    \u0441\u044B\u043D \u043C\u043E\u0439..."
  _exitDoor: {fileID: 0}
  _playerSpawnPosition: {fileID: 7738100506566521952}
  _cutScenes: {fileID: 0}
